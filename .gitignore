# Logs (may contain account IDs / ARNs from deploy runs)
*.log

# Python virtualenv
.venv/
venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Internal engagement notes — NOT for customer sharing (contains test account IDs,
# verification reports, workflow planning). Keep out of any shared/pushed repo.
.agents/

# Generated artifact (produced by flow2 sync-schema.py at deploy time)
flow2-aurora-dms-kinesis/schema-mapping.json

# Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!example.tfvars
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl

# Lambda deployment bundles generated by Terraform archive_file at apply time
terraform/**/*.zip
